<Application x:Class="CM.Gefaehrdungsbeurteilung.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="BackgroundBrush" Color="#F4F6FA"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="#155E75"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#62748A"/>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="13,8"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="MinHeight" Value="35"/>
    </Style>
    <Style TargetType="TextBox"><Setter Property="Margin" Value="0,5,0,13"/><Setter Property="Padding" Value="9,7"/><Setter Property="MinHeight" Value="34"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Margin" Value="0,5,0,13"/><Setter Property="MinHeight" Value="34"/></Style>
    <Style TargetType="DatePicker"><Setter Property="Margin" Value="0,5,0,13"/><Setter Property="MinHeight" Value="34"/></Style>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="#62748A"/><Setter Property="FontSize" Value="12"/></Style>
    <Style x:Key="Headline" TargetType="TextBlock"><Setter Property="FontSize" Value="24"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#1C3442"/></Style>
    <Style x:Key="Label" TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="Panel" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="9"/><Setter Property="Padding" Value="18"/><Setter Property="BorderBrush" Value="#DBE3EB"/><Setter Property="BorderThickness" Value="1"/></Style>
  </Application.Resources>
</Application>
